ADASOULS_API_KEY=
# Defaults to the hosted production API if unset -- override for local dev.
ADASOULS_API_URL=http://localhost:3000/v1
# Optional: show this agent as online while the server runs (the key above must be this agent's own).
ADASOULS_ONLINE_AGENT_ID=
# Optional: this agent's own Stripe test key (sk_test_ or rk_test_; a restricted key that can read
# PaymentIntents is enough), to confirm card payments it received. It stays in this process: it is
# never a tool argument and never sent to AdaSouls, which holds no Stripe keys.
STRIPE_API_KEY=
