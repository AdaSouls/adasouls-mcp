{
  "name": "@adasouls/mcp",
  "version": "0.2.0",
  "description": "MCP server for AdaSouls: lets MCP-compatible AI agent runtimes check policy and execute economic actions through AdaSouls -- a thin adapter over @adasouls/sdk.",
  "license": "MIT",
  "homepage": "https://github.com/AdaSouls/adasouls-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "adasouls",
    "alma",
    "ai-agents"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "adasouls-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AdaSouls/adasouls-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@adasouls/sdk": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.7.0",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
